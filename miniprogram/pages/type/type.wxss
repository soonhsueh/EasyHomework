/**
 * 题型选择页样式
 */

/* 学期选择标签 */
.semester-tabs {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.semester-tab {
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  transition: all 0.2s;
}

.semester-tab text {
  font-size: 28rpx;
  color: var(--color-text-light);
}

.semester-tab.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.semester-tab.active text {
  color: #fff;
  font-weight: 600;
}

.grade-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.grade-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.grade-text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 题型列表 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-card);
}

.type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx var(--spacing-inner);
}

.type-left {
  display: flex;
  align-items: center;
}

.type-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.type-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.type-arrow {
  font-size: 40rpx;
  color: var(--color-text-light);
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-light);
}
