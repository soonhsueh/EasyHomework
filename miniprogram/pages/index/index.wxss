/**
 * 首页样式 — 年级选择
 */

/* 标题区 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 年级卡片网格 */
.grade-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-card);
  padding: 0 0 40rpx;
}

.grade-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card), inset 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.grade-num {
  font-size: 64rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.grade-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 6rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 科目切换栏 */
.subject-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.subject-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-btn);
  position: relative;
  transition: background 0.2s;
}

.subject-item.active {
  background: rgba(74, 144, 217, 0.1);
}

.subject-item.disabled {
  opacity: 0.5;
}

.subject-icon {
  font-size: 40rpx;
}

.subject-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.subject-badge {
  position: absolute;
  top: 0;
  right: -10rpx;
  font-size: 16rpx;
  color: var(--color-secondary);
  background: rgba(255, 149, 0, 0.1);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-tag);
  white-space: nowrap;
}
