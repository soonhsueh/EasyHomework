<!-- 题型选择页 -->
<view class="container">
  <!-- 年级信息 -->
  <view class="grade-banner">
    <text class="grade-icon">📚</text>
    <text class="grade-text">{{gradeLabel}} · 选择练习类型</text>
  </view>

  <!-- 学期选择 -->
  <view class="semester-tabs">
    <view
      class="semester-tab {{semester === '上' ? 'active' : ''}}"
      data-semester="上"
      bindtap="onSemesterTap"
    >
      <text>上学期</text>
    </view>
    <view
      class="semester-tab {{semester === '下' ? 'active' : ''}}"
      data-semester="下"
      bindtap="onSemesterTap"
    >
      <text>下学期</text>
    </view>
  </view>

  <!-- 题型列表 -->
  <view class="type-list">
    <view
      wx:for="{{types}}"
      wx:key="key"
      class="type-card card btn-press"
      data-type="{{item.key}}"
      bindtap="onTypeTap"
    >
      <view class="type-left">
        <text class="type-icon">{{item.icon}}</text>
        <text class="type-label">{{item.label}}</text>
      </view>
      <text class="type-arrow">›</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{types.length === 0}}" class="empty-state">
    <text class="empty-icon">📭</text>
    <text class="empty-text">该年级暂无可选题型</text>
  </view>
</view>
